# Mainnet upgrade script environment variables
PRIVATE_KEY= # Private key of the deployer

# Mainnet RPC URL to perform upgrade
MAINNET_RPC_URL=

# WrappedM earners export script (earners/get-earners.ts)

# Optional - Hasura endpoint for zero-indexer wm_earner (default
http://localhost:8080/v1/graphql)
ZERO_INDEXER_GRAPHQL_URL= 

# Optional - x-hasura-admin-secret (public read needs none)
ZERO_INDEXER_GRAPHQL_SECRET= 

# Alchemy API key to generate RPC URLs for supported networks
ALCHEMY_API_KEY= 

# Public RPC URLs
MOCA_RPC_URL=https://rpc.mocachain.org
CITREA_RPC_URL=https://rpc.mainnet.citrea.xyz
MANTRA_RPC_URL=https://evm.mantrachain.io
FLUENT_RPC_URL=https://rpc.fluent.xyz
PLUME_RPC_URL=https://rpc.plume.org
ZEROG_RPC_URL=https://evmrpc.0g.ai

# Used for verifying contracts on Etherscan
ETHERSCAN_API_KEY=

# Etherscan verifiers
MAINNET_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=1"
BSC_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=56"
MONAD_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=143"
HYPEREVM_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=999"
BASE_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=8453"
PLASMA_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=9745"
ARBITRUM_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=42161"
LINEA_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=59144"

SEPOLIA_VERIFIER_URL="https://api.etherscan.io/v2/api?chainid=11155111"

# Blockscout verifiers
SONEIUM_VERIFIER_URL="https://soneium.blockscout.com/api"
CITREA_VERIFIER_URL="https://explorer.mainnet.citrea.xyz/api"
PLUME_VERIFIER_URL="https://explorer.plume.org/api"
MOCA_VERIFIER_URL="https://scan.mocachain.org/api"
RISE_VERIFIER_URL="https://explorer.risechain.com/api"
MANTRA_VERIFIER_URL="https://blockscout.mantrascan.io/api"
FLUENT_VERIFIER_URL="https://fluentscan.xyz/api"

# Custom verifiers
ZEROG_VERIFIER_URL="https://chainscan.0g.ai/api"
